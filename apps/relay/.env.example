# Historical protocol fixture only: the deployed API no longer accepts this
# relay secret. Normal remote access uses docs/cloudflare-remote.md.
# Public fixture account API origin and exact issuer for grants/tickets.
API_BASE_URL=https://accounts.example.com
API_ISSUER=https://accounts.example.com/api/v1

# Must match the secret directly injected into the account protocol fixture.
RELAY_SERVICE_TOKEN=replace-with-a-long-random-secret

# Optional capacity/listener overrides.
RELAY_PORT=8789
RELAY_MAX_PAIRS=1024
RELAY_HIGH_WATER_BYTES=1048576
